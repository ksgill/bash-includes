#!/usr/bin/env bash
# provision-report — read and verify the system change journal.
#
# Answers "what has been done to this machine, and has anything changed since?"
# Reads /var/lib/provision/changes.jsonl, written by scripts using lib/journal.sh.
#
# Deliberately dependency-free: the journal is flat JSON with string values only,
# so it is parsed here with bash regex rather than requiring jq or python.

set -euo pipefail

JOURNAL_FILE="${JOURNAL_FILE:-/var/lib/provision/changes.jsonl}"

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    C_RED=$'\033[0;31m'; C_GRN=$'\033[0;32m'; C_YEL=$'\033[1;33m'
    C_CYN=$'\033[0;36m'; C_DIM=$'\033[2m';    C_RST=$'\033[0m'
else
    C_RED=''; C_GRN=''; C_YEL=''; C_CYN=''; C_DIM=''; C_RST=''
fi

usage() {
    cat <<'HELP'
Usage: provision-report [OPTIONS]

Show the record of persistent changes made to this system.

Options:
  --verify            Re-hash every journalled file and report drift
  --run <id>          Show only records from one run
  --script <name>     Show only records written by one script
  --targets           List distinct changed paths, nothing else
  --raw               Emit matching JSONL unchanged
  -h, --help          This message

Verify status:
  OK        file still matches the hash recorded when it was changed
  CHANGED   file has been modified since — by something other than that script
  PRESENT   file still exists; no hash was recorded, so content is not checked
  MISSING   file no longer exists
  NOREAD    file could not be checked (not world-readable now, or its
            existence cannot be determined)
  SUPERSEDED  a later record in the journal is for the same path, so this
            one no longer describes the file and is not checked
  -         nothing to check (package installs, deletions, non-path targets)

Only the latest record for each path is checked. Which record is the latest
is decided over the whole journal, whatever --run or --script select, so an
earlier run's record of a file a later run changed or deleted shows
SUPERSEDED, not CHANGED or MISSING.

Hashes are recorded, and re-checked, only for content anyone on the machine
can read: other-read on the file and other-execute on every ancestor
directory. Private keys, 0600 configs and anything under a 0700 directory are
tracked by presence alone (PRESENT / MISSING).

With --verify, a record that names a backup shows whether the backup is still
there, on its "backup:" line: [present], [missing], or [unknown] (existence
cannot be determined, or the path is relative). Presence only; a backup's
content is never read. This does not change the record's own status; missing
backups are counted separately in the summary.
HELP
}

VERIFY=0; RAW=0; TARGETS=0; FILTER_RUN=""; FILTER_SCRIPT=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --verify)  VERIFY=1; shift ;;
        --raw)     RAW=1; shift ;;
        --targets) TARGETS=1; shift ;;
        --run)     FILTER_RUN="${2:-}"; shift 2 ;;
        --script)  FILTER_SCRIPT="${2:-}"; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'Unknown option: %s\n\n' "$1" >&2; usage >&2; exit 1 ;;
    esac
done

if [[ ! -r "$JOURNAL_FILE" ]]; then
    printf 'No journal at %s — nothing has been recorded on this system.\n' "$JOURNAL_FILE" >&2
    exit 1
fi

# Extract one string field from a flat JSON object, honouring backslash escapes.
# Escapes are decoded in one left-to-right pass: replacing them one kind at a
# time turned the JSON text `a\\name` (a backslash, then "name") into a newline.
# \u00XX covers the control characters journal.sh escapes; any other \uXXXX is
# left as written, since the journal never emits one.
jget() {
    local line="$1" key="$2" v out="" c hex i
    [[ "$line" =~ \"$key\":\"(([^\"\\]|\\.)*)\" ]] || return 0
    v="${BASH_REMATCH[1]}"
    if [[ "$v" != *\\* ]]; then
        printf '%s' "$v"
        return 0
    fi
    for (( i = 0; i < ${#v}; i++ )); do
        c="${v:i:1}"
        if [[ "$c" == "\\" ]]; then
            i=$((i + 1))
            c="${v:i:1}"
            case "$c" in
                n) c=$'\n' ;;
                t) c=$'\t' ;;
                r) c=$'\r' ;;
                b) c=$'\b' ;;
                f) c=$'\f' ;;
                u)
                    hex="${v:i+1:4}"
                    if [[ "$hex" =~ ^00[0-7][0-9a-fA-F]$ && "$hex" != "0000" ]]; then
                        printf -v c '%b' "\\x${hex:2}"
                        i=$((i + 4))
                    else
                        c="\\u"
                    fi
                    ;;
                # \" \\ \/ stand for the character itself.
            esac
        fi
        out+="$c"
    done
    printf '%s' "$out"
}

# ── file_sha256 <path> ────────────────────────────────────────────────────────
# Print the bare 64-hex sha256 of a file whose content anyone on the machine
# can read, or fail and print nothing. Mirrors _sha256_of in lib/journal.sh —
# verify must apply the same rule and hash the same way as the journal did, or
# every difference in method reads as drift. It is copied rather than sourced
# because this command is deliberately standalone: it runs on machines that
# have the built installers but no bash-includes checkout. See journal.sh for
# the full reasoning; in short:
#   - world-readable content only: other-read on the canonical file and
#     other-execute on each canonical ancestor; symlinks are resolved
#     (`realpath -e`) and the rule applies to what they point at. No sudo;
#   - absolute paths only, so a bare target name is never resolved against the
#     working directory, where a planted symlink could redirect it;
#   - hashed from stdin, never by name (sha256sum prefixes `\` to the line for
#     a name holding a backslash or newline);
#   - dd with O_NOFOLLOW and O_NONBLOCK under `timeout`, so a swapped-in
#     symlink or FIFO can neither redirect nor hang the read; the timeout must
#     be a positive integer, since `timeout 0` means no limit.
# Residual: O_NOFOLLOW covers only the last path component; a symlink planted
# as an intermediate directory between check and read is still followed.
HASH_TIMEOUT="${_JOURNAL_HASH_TIMEOUT:-60}"
[[ "$HASH_TIMEOUT" =~ ^[1-9][0-9]*$ ]] || HASH_TIMEOUT=60

file_sha256() {
    local f="$1" c d m out
    local -a dirs=() modes=()
    [[ "$f" == /* ]] || return 1
    c="$(realpath -e -- "$f" 2>/dev/null && printf .)" || return 1
    c="${c%.}"
    c="${c%$'\n'}"
    [[ "$c" == /* && -f "$c" && ! -L "$c" ]] || return 1
    d="$c"
    while [[ "$d" != "/" ]]; do
        d="${d%/*}"
        d="${d:-/}"
        dirs+=("$d")
    done
    mapfile -t modes < <(stat -c '%a' -- "$c" "${dirs[@]}" 2>/dev/null)
    [[ ${#modes[@]} -eq $(( ${#dirs[@]} + 1 )) ]] || return 1
    for m in "${modes[@]}"; do
        [[ "$m" =~ ^[0-7]{3,4}$ ]] || return 1
    done
    (( (8#${modes[0]} & 8#4) != 0 )) || return 1
    for m in "${modes[@]:1}"; do
        (( (8#$m & 8#1) != 0 )) || return 1
    done
    out="$(set -o pipefail
           timeout -k 2 "$HASH_TIMEOUT" dd if="$c" iflag=nofollow,nonblock status=none 2>/dev/null \
               | sha256sum 2>/dev/null)" || return 1
    out="${out%% *}"
    [[ "$out" =~ ^[0-9a-f]{64}$ ]] || return 1
    printf '%s\n' "$out"
}

# ── path_state <path> ─────────────────────────────────────────────────────────
# Set PATH_STATE to present, absent or unknown. An unprivileged `-e` answers
# when the path is visible, or when the nearest existing ancestor is a
# directory we can search. Behind one we cannot (a 0700 /etc/wireguard), `sudo
# -n test -e` answers instead: it reads metadata only — never content — so it
# does not touch the world-readable rule, and without it every root-only file
# the journal tracks by presence would be unknowable. `-n` never prompts; a
# sudo that cannot run leaves the answer unknown. A relative path is never
# judged: it would be resolved against the working directory, not the machine.
#
# Whether sudo can run without a prompt is asked once and remembered in
# SUDO_USABLE, so a journal with many root-only paths makes one probe, not one
# per record. That is why the answer comes back in a variable: called in a
# command substitution, this would run in a subshell and remember nothing.
PATH_STATE=""
SUDO_USABLE=""

path_state() {
    local f="$1" d
    if [[ "$f" != /* ]]; then
        PATH_STATE=unknown
        return 0
    fi
    if [[ -e "$f" ]]; then
        PATH_STATE=present
        return 0
    fi
    d="$f"
    # Parameter expansion, not $(dirname), which strips a trailing newline.
    while [[ ! -e "$d" && "$d" != "/" ]]; do
        d="${d%/*}"
        d="${d:-/}"
    done
    if [[ -d "$d" && -x "$d" ]]; then
        PATH_STATE=absent
        return 0
    fi
    if [[ -z "$SUDO_USABLE" ]]; then
        if sudo -n true 2>/dev/null; then
            SUDO_USABLE=yes
        else
            SUDO_USABLE=no
        fi
    fi
    if [[ "$SUDO_USABLE" != yes ]]; then
        PATH_STATE=unknown
    elif sudo -n test -e "$f" 2>/dev/null; then
        PATH_STATE=present
    else
        PATH_STATE=absent
    fi
}

# ── path_key <path> ───────────────────────────────────────────────────────────
# Set PATH_KEY to the form of an absolute path that records are matched on
# when deciding which is the latest for a file: repeated slashes collapsed and
# a trailing slash dropped (the root stays "/"), so /etc//x and /etc/x are one
# target. Lexical only: symlinks are not resolved, and "." and ".." are left
# as written, so two different spellings through a link stay two targets.
# Matching only; display and every file check use the journalled value.
PATH_KEY=""

path_key() {
    PATH_KEY="$1"
    while [[ "$PATH_KEY" == *//* ]]; do
        PATH_KEY="${PATH_KEY//\/\//\/}"
    done
    if [[ "$PATH_KEY" != / ]]; then
        PATH_KEY="${PATH_KEY%/}"
    fi
}

# ── vis <string> ──────────────────────────────────────────────────────────────
# Render a journalled string for the terminal. jget returns the exact bytes,
# so a target holding ESC would otherwise reach the terminal as a live escape
# sequence. Display only: comparisons and file operations use the exact value.
#
# In a UTF-8 locale every character that is not [[:print:]] — C0, DEL, C1 — is
# shown as \xNN (or \uNNNN above 0x7f); printable multibyte text is untouched.
# In any other locale bash sees bytes, and [[:cntrl:]] misses a UTF-8-encoded
# C1 control such as C2 9B (CSI), which a UTF-8 terminal still obeys; there,
# control bytes and every byte 0x80-0x9f are shown as \xNN. That leaves the
# lead byte of such a pair, and all of 0xa0-0xff, as they were, so ordinary
# accented names still read correctly on a UTF-8 terminal, and on an 8-bit
# terminal 0x80-0x9f is exactly its C1 range.
_VIS_UTF8=0
_vis_probe=$'\xc3\xa9'
[[ ${#_vis_probe} -eq 1 ]] && _VIS_UTF8=1
unset _vis_probe

vis() {
    local s="$1" out="" c n i
    if [[ "$_VIS_UTF8" -eq 1 ]]; then
        if [[ "$s" != *[![:print:]]* ]]; then
            printf '%s' "$s"
            return 0
        fi
    elif [[ "$s" != *[[:cntrl:]]* && "$s" != *[$'\x80'-$'\x9f']* ]]; then
        printf '%s' "$s"
        return 0
    fi
    for (( i = 0; i < ${#s}; i++ )); do
        c="${s:i:1}"
        if [[ "$_VIS_UTF8" -eq 1 && "$c" != [[:print:]] ]] \
            || [[ "$_VIS_UTF8" -eq 0 && ( "$c" == [[:cntrl:]] || "$c" == [$'\x80'-$'\x9f'] ) ]]; then
            printf -v n '%d' "'$c"
            if (( n < 128 || _VIS_UTF8 == 0 )); then
                printf -v c '\\x%02x' "$(( n & 0xff ))"
            else
                printf -v c '\\u%04x' "$n"
            fi
        fi
        out+="$c"
    done
    printf '%s' "$out"
}

last_run=""
total=0; ok=0; changed=0; missing=0; unreadable=0; present=0
superseded=0; backups_missing=0
targets_seen=()

# ── Which record is the latest for each path (--verify only) ─────────────────
# A record describes a file as it was left then. Once a later record exists
# for the same path — a modify after a create, a delete after a backup — the
# earlier one no longer describes anything that can be checked, and judging
# it against the file as it is now reports drift the journal itself explains.
# So only the latest record for a path is checked. "Latest" is over the whole
# journal, before --run and --script are applied: a filter chooses what is
# shown, not what happened. Only absolute paths take part; a package or unit
# name is never checked anyway. Records are numbered by non-empty line, the
# same count the display loop keeps.
declare -A latest_for=()
if [[ "$VERIFY" -eq 1 && "$RAW" -eq 0 && "$TARGETS" -eq 0 ]]; then
    recno=0
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        recno=$((recno + 1))
        # The trailing dot keeps a newline that ends the path.
        target="$(jget "$line" target; printf .)"
        target="${target%.}"
        [[ "$target" == /* ]] || continue
        path_key "$target"
        latest_for["$PATH_KEY"]="$recno"
    done < "$JOURNAL_FILE"
fi

recno=0
while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    recno=$((recno + 1))

    run="$(jget "$line" run)"
    script="$(jget "$line" script)"

    [[ -n "$FILTER_RUN"    && "$run"    != "$FILTER_RUN"    ]] && continue
    [[ -n "$FILTER_SCRIPT" && "$script" != "$FILTER_SCRIPT" ]] && continue

    total=$((total + 1))

    if [[ "$RAW" -eq 1 ]]; then
        printf '%s\n' "$line"
        continue
    fi

    # The trailing dot survives command substitution, which would otherwise
    # strip a newline that ends the path.
    target="$(jget "$line" target; printf .)"
    target="${target%.}"

    if [[ "$TARGETS" -eq 1 ]]; then
        # Deduplicated at the end — a target changed by five runs is one line.
        targets_seen+=("$(vis "$target")")
        continue
    fi

    ts="$(jget "$line" ts)"
    action="$(jget "$line" action)"
    detail="$(jget "$line" detail)"
    version="$(jget "$line" version)"
    backup="$(jget "$line" backup)"
    sha="$(jget "$line" sha256_after)"

    # Run header whenever the run id changes.
    if [[ "$run" != "$last_run" ]]; then
        [[ -n "$last_run" ]] && printf '\n'
        printf '%s● run %s  %s  %s%s\n' \
            "$C_CYN" "$(vis "$run")" "$(vis "$script")" "$(vis "${version:-unknown}")" "$C_RST"
        last_run="$run"
    fi

    status=""
    backup_note=""
    if [[ "$VERIFY" -eq 1 && -n "$backup" ]]; then
        # Presence only, and it never changes the record's own status.
        path_state "$backup"
        case "$PATH_STATE" in
            present) backup_note="  ${C_GRN}[present]${C_RST}" ;;
            absent)  backup_note="  ${C_RED}[missing]${C_RST}"; backups_missing=$((backups_missing + 1)) ;;
            *)       backup_note="  ${C_YEL}[unknown]${C_RST}" ;;
        esac
    fi
    if [[ "$VERIFY" -eq 1 ]]; then
        state=""
        PATH_KEY=""
        if [[ "$target" == /* ]]; then
            path_key "$target"
        fi
        if [[ -n "$PATH_KEY" && "${latest_for["$PATH_KEY"]:-$recno}" -ne "$recno" ]]; then
            status="${C_DIM}SUPERSEDED${C_RST} "; superseded=$((superseded + 1))
        elif [[ -z "$sha" ]]; then
            # No hash: a file that is not world-readable, a nohash record, or
            # not a file at all. A path that should still exist is checked for
            # presence; deletions and bare names have nothing to check.
            if [[ "$target" == /* && "$action" != "delete" && "$action" != "remove" ]]; then
                path_state "$target"
                state="$PATH_STATE"
            fi
            case "$state" in
                present) status="${C_CYN}PRESENT${C_RST} "; present=$((present + 1)) ;;
                absent)  status="${C_RED}MISSING${C_RST} "; missing=$((missing + 1)) ;;
                unknown) status="${C_YEL}NOREAD ${C_RST} "; unreadable=$((unreadable + 1)) ;;
                *)       status="${C_DIM}   -    ${C_RST}" ;;
            esac
        elif path_state "$target" && [[ "$PATH_STATE" == "absent" ]]; then
            status="${C_RED}MISSING${C_RST} "; missing=$((missing + 1))
        else
            # A file that fails the world-readable rule now — or cannot be
            # read — must report NOREAD, never CHANGED: reporting drift we
            # could not actually measure would send you chasing a change that
            # never happened.
            now="$(file_sha256 "$target" || true)"

            if [[ -z "$now" ]]; then
                status="${C_YEL}NOREAD ${C_RST} "; unreadable=$((unreadable + 1))
            elif [[ "$now" == "$sha" ]]; then
                status="${C_GRN}  OK   ${C_RST} "; ok=$((ok + 1))
            else
                status="${C_YEL}CHANGED${C_RST} "; changed=$((changed + 1))
            fi
        fi
    fi

    printf '  %s%s  %-8s %s\n' "$status" "$(vis "${ts:0:19}")" "$(vis "$action")" "$(vis "$target")"
    [[ -n "$detail" ]] && printf '            %s%s%s\n' "$C_DIM" "$(vis "$detail")" "$C_RST"
    [[ -n "$backup" ]] && printf '            %sbackup: %s%s%s\n' "$C_DIM" "$(vis "$backup")" "$C_RST" "$backup_note"
done < "$JOURNAL_FILE"

if [[ "$TARGETS" -eq 1 ]]; then
    [[ ${#targets_seen[@]} -gt 0 ]] && printf '%s\n' "${targets_seen[@]}" | awk '!seen[$0]++'
fi

if [[ "$RAW" -eq 0 && "$TARGETS" -eq 0 ]]; then
    printf '\n%d record(s)' "$total"
    [[ "$VERIFY" -eq 1 ]] && printf '  —  %d ok, %d changed, %d missing, %d unreadable, %d present, %d superseded  —  %d backup(s) missing' \
        "$ok" "$changed" "$missing" "$unreadable" "$present" "$superseded" "$backups_missing"
    printf '\n'
fi
